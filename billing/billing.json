{
    "db": {
        "host": "billing_db",
        "port": 5432,
        "user": "root",
        "password": "root",
        "dbname": "billing",
        "sslmode": "disable",
        "timezone": "America/Sao_Paulo",
        "connect_timeout": 10,
        "billing_schema": "billing"
    },
    "log": {
        "output": "./log/billing.log",
        "level": 0
    },
    "web": {
        "addr": ":8081"
    },
    "nats": {
        "url": "nats://nats:4222",
        "queue_group": "billing-customer-sync",
        "enabled": true
    },
    "service": {
        "payment_timeout": 20
    },
    "auto_bill": {
        "enabled": true,
        "days_in_advance": 3,
        "hours": [8, 14],
        "schedules": [
            "45 21 * * *"
        ]
    }
}