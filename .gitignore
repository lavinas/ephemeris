# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# tmp files
tmp/
files/

# logs
*.log

# executable files
*.exe

# python
__pycache__/
*.pyc
**/__pycache__/
**/*.pyc

# database
*.db
*.sqlite
*.sqlite3


# Ignorar dependências e builds (geralmente já estão no gitignore)
node_modules/
.venv/
dist/
build/

# Ignorar arquivos de mídia pesados que gastam contexto da IA
*.png
*.jpg
*.jpeg
*.svg
*.mp4
*.pdf

# Ignorar logs e arquivos temporários de execução
*.log
.env*
.ds_store

# ==========================================
# Segurança: Certificados e Chaves Privadas
# ==========================================
# Ignora arquivos de chaves privadas especificamente
*.key
*.pem
*.pfx
*.p12

# Ignora pastas inteiras que contenham certificados locais de desenvolvimento
**/configs/certs/*.key
**/configs/certs/*.pem
**/assets/certs/*.key

# Se você usa ferramentas como o mkcert para gerar certificados locais, ignore-os:
rootCA*.pem

# ==========================================
# Arquivos de Configuração com Dados Sensíveis
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Binários e Artefatos do Go
# ==========================================
# Ignora o binário compilado na raiz ou subpastas
/meu-projeto-go
*.exe
*.exe_
*.dll
*.so
*.dylib

# Diretório de build comum
/dist/
/build/

# ==========================================
# Ferramentas e IDEs
# ==========================================
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
